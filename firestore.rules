rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == "sumeyaferejo@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'lastSeen'])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && (request.auth.token.email_verified == true || request.auth.token.email == "sumeyaferejo@gmail.com");
    }

    // Paper Validation
    function isValidPaper(data) {
      return data.keys().hasAll(['title', 'schoolId', 'grade', 'subject', 'category', 'uploadedBy', 'createdAt'])
        && data.title is string && data.title.size() <= 200
        && (!data.keys().contains('content') || (data.content is string && data.content.size() <= 50000))
        && data.schoolId is string && data.schoolId.size() <= 100
        && data.grade is string && data.grade.size() <= 20
        && data.subject is string && data.subject.size() <= 100
        && data.category in ['Periodically', 'Topically']
        && (!data.keys().contains('unitNumber') || (data.unitNumber is string && data.unitNumber.size() <= 10))
        && (!data.keys().contains('description') || (data.description is string && data.description.size() <= 500))
        && (!data.keys().contains('year') || (data.year is string && data.year.size() <= 10))
        && (!data.keys().contains('fileUrl') || (data.fileUrl is string && data.fileUrl.size() <= 1000))
        && (!data.keys().contains('fileType') || (data.fileType is string && data.fileType.size() <= 100))
        && data.uploadedBy == request.auth.uid
        && data.createdAt == request.time
        && (request.auth.token.email_verified == true || request.auth.token.email == "sumeyaferejo@gmail.com");
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isSignedIn() && userId == request.auth.uid && isValidUser(request.resource.data);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Papers Collection
    match /papers/{paperId} {
      // Browsing papers is public or signed in
      allow read: if true; 
      
      // Uploading papers requires admin status
      allow create: if isAdmin() && isValidId(paperId) && isValidPaper(request.resource.data);
      
      // Updating papers requires admin status
      allow update: if isAdmin() && isValidId(paperId) && isValidPaper(request.resource.data)
        && request.resource.data.uploadedBy == resource.data.uploadedBy;
        
      // Deleting papers requires admin status
      allow delete: if isAdmin();
    }
  }
}
